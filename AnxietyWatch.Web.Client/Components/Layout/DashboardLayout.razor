@inherits LayoutComponentBase

<div class="dashboard-shell">
    <aside class="dashboard-sidebar">
        <a class="sidebar-brand" href="/dashboard" aria-label="Ir al resumen de AnxietyWatch">
            <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" role="img">
                    <path d="M12 21c4.5-2.7 7-6.4 7-10.2A4.8 4.8 0 0 0 14.2 6c-.9 0-1.7.2-2.2.8A3 3 0 0 0 9.8 6 4.8 4.8 0 0 0 5 10.8C5 14.6 7.5 18.3 12 21Z" />
                    <path d="M8.3 12h2l1.1-2.3 1.6 4.6 1.1-2.3h1.8" />
                </svg>
            </span>
            <span>AnxietyWatch</span>
        </a>

        <nav class="sidebar-nav" aria-label="Navegación del dashboard">
            <NavLink class="sidebar-link" href="/dashboard" Match="NavLinkMatch.All">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 13h6V4H4v9Zm0 7h6v-4H4v4Zm10 0h6v-9h-6v9Zm0-16v4h6V4h-6Z" />
                </svg>
                <span>Resumen</span>
            </NavLink>

            <NavLink class="sidebar-link" href="/dashboard/plan" Match="NavLinkMatch.All">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 7.5h16v11H4v-11Zm3-3h10v3H7v-3Zm1 7h8m-8 3h5" />
                </svg>
                <span>Mi plan</span>
            </NavLink>

            <NavLink class="sidebar-link" href="/dashboard/tokens" Match="NavLinkMatch.All">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M9.5 14.5 14.5 9M7 17l-1.5 1.5a3.5 3.5 0 0 1-5-5L5 9a3.5 3.5 0 0 1 5 0m7 6a3.5 3.5 0 0 0 5 0l1.5-1.5a3.5 3.5 0 0 0-5-5L14 13a3.5 3.5 0 0 0 0 5" />
                </svg>
                <span>Tokens de vinculación</span>
            </NavLink>

            <NavLink class="sidebar-link" href="/dashboard/help" Match="NavLinkMatch.All">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M9.8 9a2.4 2.4 0 0 1 4.6 1c0 2-2.4 2.2-2.4 4m0 3h.01" />
                </svg>
                <span>Centro de ayuda</span>
            </NavLink>

        </nav>

        <div class="sidebar-footer">
            <section class="token-status" aria-labelledby="token-status-title">
                <p class="token-plan" id="token-status-title">Plan Familiar</p>
                <div class="token-status__header">
                    <strong>5 de 5 tokens</strong>
                </div>
                <div class="token-progress" role="progressbar" aria-valuemin="0" aria-valuemax="5" aria-valuenow="5">
                    <span></span>
                </div>
                <p class="token-renewal">Renovación @DateTime.Today.AddMonths(1).ToString("dd/MM/yyyy")</p>
            </section>

            <a class="logout-link" href="/login">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M10 5H5v14h5m4-4 4-3-4-3m4 3H9" />
                </svg>
                <span>Cerrar sesión</span>
            </a>
        </div>
    </aside>

    <div class="dashboard-workspace">
        <header class="dashboard-topbar">
            <a class="back-link" href="/">
                <span>&larr; Volver al inicio</span>
            </a>

            <div class="topbar-actions">
                <button class="notification-button" type="button" aria-label="Notificaciones" title="Notificaciones">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9Zm-8 12h4" />
                    </svg>
                    <span class="notification-dot" aria-hidden="true"></span>
                </button>

                <a class="new-token-button" href="/dashboard/tokens?new=true">
                    <span aria-hidden="true">+</span>
                    Nuevo token
                </a>

                <details class="user-menu">
                    <summary class="user-profile" aria-label="Abrir menú del perfil de Alex Rivera">
                        <span class="user-avatar" aria-hidden="true">AR</span>
                        <span class="user-copy">
                            <strong>Alex Rivera</strong>
                            <small>Plan Profesional</small>
                        </span>
                        <svg class="profile-chevron" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="m8 10 4 4 4-4" />
                        </svg>
                    </summary>

                    <div class="profile-dropdown">
                        <header class="profile-dropdown__header">
                            <span class="user-avatar user-avatar--large" aria-hidden="true">AR</span>
                            <span class="profile-dropdown__identity">
                                <strong>Alex Rivera</strong>
                                <small>alex@demo.com</small>
                                <span>Plan Profesional</span>
                            </span>
                        </header>

                        <hr />

                        <nav class="profile-dropdown__links" aria-label="Opciones del perfil">
                            <a href="/dashboard/profile">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <circle cx="12" cy="8" r="3.5" />
                                    <path d="M5 20c.5-5 2.8-7.5 7-7.5s6.5 2.5 7 7.5" />
                                </svg>
                                <span>Mi perfil</span>
                            </a>
                            <a href="/dashboard/billing">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <rect x="3" y="5" width="18" height="14" rx="3" />
                                    <path d="M3 9h18M7 15h4" />
                                </svg>
                                <span>Facturación</span>
                            </a>

                            <hr />

                            <a class="profile-logout" href="/login">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M10 5H5v14h5m4-4 4-3-4-3m4 3H9" />
                                </svg>
                                <span>Cerrar sesión</span>
                            </a>
                        </nav>
                    </div>
                </details>
            </div>
        </header>

        <main class="dashboard-main">
            @Body
        </main>
    </div>
</div>
