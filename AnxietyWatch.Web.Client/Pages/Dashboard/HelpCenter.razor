@page "/dashboard/help"
@using System.ComponentModel.DataAnnotations
@layout DashboardLayout
@rendermode InteractiveWebAssembly

<PageTitle>Centro de ayuda | AnxietyWatch</PageTitle>

<section class="help-page" aria-labelledby="help-title">
    <header class="help-header">
        <span>Soporte</span>
        <h1 id="help-title">Centro de ayuda</h1>
        <p>Soporte por email · Respuesta en 24-48 h</p>
    </header>

    <div class="help-grid">
        <section class="faq-column" aria-labelledby="faq-title">
            <header class="section-heading">
                <div>
                    <h2 id="faq-title">Preguntas frecuentes</h2>
                    <p>Encuentra respuestas rápidas sobre AnxietyWatch.</p>
                </div>
                <span>@filteredFaqs.Count() resultados</span>
            </header>

            <div class="input-icon-wrapper faq-search">
                <svg class="input-icon-element faq-search__icon" viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" />
                    <path d="m16 16 5 5" />
                </svg>
                <input class="form-input input-with-padding"
                       type="search"
                       placeholder="Buscar pregunta..."
                       aria-label="Buscar pregunta frecuente"
                       @bind="searchQuery"
                       @bind:event="oninput" />
            </div>

            <div class="faq-filters" role="group" aria-label="Filtrar preguntas por categoría">
                @foreach (var category in FaqCategories)
                {
                    <button type="button"
                            class="@(selectedCategory == category ? "is-active" : null)"
                            aria-pressed="@(selectedCategory == category)"
                            @onclick="() => SelectCategory(category)">
                        @category
                    </button>
                }
            </div>

            <div class="faq-list">
                @if (!filteredFaqs.Any())
                {
                    <div class="faq-empty">
                        <strong>No encontramos resultados</strong>
                        <p>Prueba con otra búsqueda o selecciona una categoría diferente.</p>
                    </div>
                }
                else
                {
                    @foreach (var faq in filteredFaqs)
                    {
                        <article class="faq-item @(openFaqId == faq.Id ? "is-open" : null)">
                            <button type="button"
                                    aria-expanded="@(openFaqId == faq.Id)"
                                    aria-controls="faq-answer-@faq.Id"
                                    @onclick="() => ToggleFaq(faq.Id)">
                                <span class="faq-question">@faq.Question</span>
                                <span class="faq-category">@faq.Category</span>
                                <svg class="faq-chevron" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="m7 9 5 5 5-5" />
                                </svg>
                            </button>
                            @if (openFaqId == faq.Id)
                            {
                                <div class="faq-answer" id="faq-answer-@faq.Id">
                                    <p>@faq.Answer</p>
                                </div>
                            }
                        </article>
                    }
                }
            </div>
        </section>

        <aside class="ticket-column">
            <section class="ticket-card" aria-labelledby="ticket-title">
                <header class="ticket-card__header">
                    <span aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4v8Z" />
                            <path d="M8 9h8m-8 4h5" />
                        </svg>
                    </span>
                    <div>
                        <h2 id="ticket-title">Enviar ticket</h2>
                        <p>Cuéntanos cómo podemos ayudarte.</p>
                    </div>
                </header>

                @if (ticketSentSuccessfully)
                {
                    <div class="ticket-success" role="status">¡Ticket enviado con éxito! Te responderemos por correo.</div>
                }

                <EditForm Model="ticketModel" OnValidSubmit="SubmitTicket" class="ticket-form">
                    <DataAnnotationsValidator />

                    <div class="ticket-field">
                        <label for="ticket-subject">Asunto</label>
                        <InputText id="ticket-subject"
                                   class="form-input"
                                   placeholder="Describe brevemente tu problema"
                                   @bind-Value="ticketModel.Subject" />
                        <ValidationMessage For="@(() => ticketModel.Subject)" />
                    </div>

                    <div class="ticket-form__row">
                        <div class="ticket-field">
                            <label for="ticket-category">Categoría</label>
                            <InputSelect id="ticket-category" class="form-input" @bind-Value="ticketModel.Category">
                                <option value="General">General</option>
                                <option value="Tokens">Tokens</option>
                                <option value="Facturación">Facturación</option>
                                <option value="Error Técnico">Error Técnico</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => ticketModel.Category)" />
                        </div>

                        <div class="ticket-field">
                            <label for="ticket-priority">Prioridad</label>
                            <InputSelect id="ticket-priority" class="form-input" @bind-Value="ticketModel.Priority">
                                <option value="Baja">Baja</option>
                                <option value="Normal">Normal</option>
                                <option value="Alta">Alta</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => ticketModel.Priority)" />
                        </div>
                    </div>

                    <div class="ticket-field">
                        <label for="ticket-message">Mensaje</label>
                        <InputTextArea id="ticket-message"
                                       class="form-input ticket-message"
                                       rows="4"
                                       placeholder="Describe el problema con el mayor detalle posible..."
                                       @bind-Value="ticketModel.Message" />
                        <ValidationMessage For="@(() => ticketModel.Message)" />
                    </div>

                    <button class="ticket-submit" type="submit">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="m3 11 18-8-8 18-2-8-8-2Z" />
                            <path d="m11 13 5-5" />
                        </svg>
                        Enviar ticket
                    </button>
                </EditForm>
            </section>
        </aside>
    </div>
</section>

@code {
    private static readonly IReadOnlyList<string> FaqCategories =
        ["Todas", "Tokens", "Plan", "App", "Seguridad", "Soporte"];

    private static readonly IReadOnlyList<FaqItem> Faqs =
    [
        new(1, "¿Cómo genero un token de vinculación?", "Desde el panel ve a Tokens de vinculación, pulsa Nuevo token y selecciona el tipo de acceso que necesitas. Cada código puede utilizarse una sola vez.", "Tokens"),
        new(2, "¿Cuánto tiempo permanece activo un token?", "Los tokens sin utilizar caducan después de 30 días. Puedes regenerarlos o eliminarlos desde la tabla de tokens.", "Tokens"),
        new(3, "¿Puedo cambiar de plan en cualquier momento?", "Sí. Puedes cambiar tu suscripción desde Mi plan. Los cambios de precio y límites se muestran antes de confirmar.", "Plan"),
        new(4, "¿Cómo sincronizo la aplicación móvil?", "Instala la app, inicia sesión y utiliza un token de tipo App Móvil para vincular el dispositivo con tu cuenta.", "App"),
        new(5, "¿Cómo protege AnxietyWatch mis datos?", "Aplicamos controles de acceso y tokens de un solo uso. Nunca compartas tus credenciales ni códigos de vinculación en canales públicos.", "Seguridad"),
        new(6, "¿Cuándo recibiré respuesta a mi ticket?", "Nuestro equipo responde por correo normalmente en un plazo de 24 a 48 horas laborables.", "Soporte"),
        new(7, "¿Qué ocurre si alcanzo el límite de tokens?", "Elimina un token que ya no necesites o cambia a un plan con mayor capacidad desde la sección Mi plan.", "Tokens"),
        new(8, "¿Cómo recupero el acceso a mi cuenta?", "Usa el enlace de recuperación en el inicio de sesión. Si no puedes acceder a tu correo, envía un ticket a Soporte.", "Seguridad")
    ];

    private TicketModel ticketModel = new();
    private string searchQuery = string.Empty;
    private string selectedCategory = "Todas";
    private int? openFaqId;
    private bool ticketSentSuccessfully;

    private IEnumerable<FaqItem> filteredFaqs => Faqs.Where(faq =>
        (selectedCategory == "Todas" || faq.Category == selectedCategory) &&
        (string.IsNullOrWhiteSpace(searchQuery) ||
         faq.Question.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
         faq.Answer.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)));

    private void SelectCategory(string category)
    {
        selectedCategory = category;
        openFaqId = null;
    }

    private void ToggleFaq(int faqId)
    {
        openFaqId = openFaqId == faqId ? null : faqId;
    }

    private void SubmitTicket()
    {
        ticketModel = new TicketModel();
        ticketSentSuccessfully = true;
    }

    public sealed class FaqItem
    {
        public FaqItem(int id, string question, string answer, string category)
        {
            Id = id;
            Question = question;
            Answer = answer;
            Category = category;
        }

        public int Id { get; }
        public string Question { get; }
        public string Answer { get; }
        public string Category { get; }
    }

    public sealed class TicketModel
    {
        [Required(ErrorMessage = "El asunto es obligatorio.")]
        public string Subject { get; set; } = string.Empty;

        [Required(ErrorMessage = "Selecciona una categoría.")]
        public string Category { get; set; } = "General";

        [Required(ErrorMessage = "Selecciona una prioridad.")]
        public string Priority { get; set; } = "Normal";

        [Required(ErrorMessage = "El mensaje es obligatorio.")]
        public string Message { get; set; } = string.Empty;
    }
}
